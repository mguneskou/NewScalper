# Copy this file to .env and fill in your real values. .env is gitignored.

# Oanda v20 practice (demo) account personal access token.
# Generate one at https://www.oanda.com/demo-account/tpa/personal_token
OANDA_API_TOKEN=

# Your Oanda practice account ID, e.g. 101-004-1234567-001
OANDA_ACCOUNT_ID=

# practice or live -- this app is built for practice only; live is not supported.
OANDA_ENV=practice
